{
  "name": "aquatech-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node --import tsx src/setup.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "whatsapp:pair": "node --env-file-if-exists=.env dist/pair.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "csv-parse": "7.0.3",
    "google-auth-library": "11.3.1",
    "libphonenumber-js": "1.13.15",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
