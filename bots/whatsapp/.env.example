# npm run setup completa las claves locales. No compartir este archivo una vez copiado a .env.
ADMIN_API_KEY=
AUTH_ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/bot.sqlite
MODE=simulation
WHATSAPP_PROVIDER=cloud_api
SEND_ENABLED=false
# Datos de la app de Meta. Cargarlos en Variables de Railway, nunca en Git.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Copiar la versión de Graph API indicada en el panel de la app (formato vNN.0).
META_GRAPH_VERSION=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
AUTO_REPLY_ENABLED=false
TIME_ZONE=America/Argentina/Cordoba
START_HOUR=8
END_HOUR=20
# 1=lunes, 7=domingo. Confirmar los días antes de activar envíos.
ACTIVE_DAYS=1,2,3,4,5
DAILY_LIMIT=20
# Espaciado operativo. No es una protección contra suspensiones.
SEND_INTERVAL_SECONDS=1800
BUSINESS_NAME=Aquatech
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=Contactos!A:E
GOOGLE_APPLICATION_CREDENTIALS=
SHEETS_SYNC_SECONDS=600
SHEETS_MAX_AGE_SECONDS=900
