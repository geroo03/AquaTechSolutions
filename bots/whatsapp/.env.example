# npm run setup completa las claves locales. No compartir este archivo una vez copiado a .env.
ADMIN_API_KEY=
AUTH_ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/bot.sqlite
MODE=simulation
SEND_ENABLED=false
TIME_ZONE=America/Argentina/Cordoba
START_HOUR=8
END_HOUR=20
# 1=lunes, 7=domingo. Confirmar los días antes de activar envíos.
ACTIVE_DAYS=1,2,3,4,5
DAILY_LIMIT=20
# Espaciado operativo. No es una protección contra suspensiones.
SEND_INTERVAL_SECONDS=1800
BUSINESS_NAME=Aquatech
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=Contactos!A:E
GOOGLE_APPLICATION_CREDENTIALS=
SHEETS_SYNC_SECONDS=600
SHEETS_MAX_AGE_SECONDS=900
