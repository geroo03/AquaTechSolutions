# Analítica (opcional). Elegí UNA y cargala como variable del repo en GitHub:
# Settings → Secrets and variables → Actions → Variables.
# Recomendada: Cloudflare Web Analytics (gratis, sin cookies). Cuenta visitas; los clics por botón
# se cuentan en WhatsApp gracias al texto "(Enviado desde la web)" de cada mensaje.
VITE_CF_BEACON_TOKEN=
# Alternativas: Plausible (pago) o Google Analytics 4 (gratis, con cookies). Ambas registran el evento "WhatsApp".
VITE_PLAUSIBLE_DOMAIN=
VITE_GA_ID=
